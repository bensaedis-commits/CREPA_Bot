# CREPA Bot - Environment Variables
# انسخ هذا الملف إلى .env وعبئ القيم الخاصة بك

# توكن البوت من Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# ID السيرفر الرئيسي (Guild ID) للأوامر الخاصة بالسيرفر
GUILD_ID=your_guild_id_here

# ID العميل (Client ID / Application ID) للبوت
CLIENT_ID=your_client_id_here

# بيئة التشغيل
NODE_ENV=production
